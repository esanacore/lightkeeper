<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone in a cloud backup or a device-to-device transfer:
  not the settings, and not the sealed token (whose Keystore key could not be
  moved anyway). Android 12 and later read this; allowBackup="false" covers
  older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
