<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext traffic to any host, and only the system's trusted certificate
  authorities (never a user-added one), so glucose data and the Nightscout
  token only ever travel over verified HTTPS. tests/test_android.py checks this.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
