# Example configuration for lightkeeper. Copy to .env (never committed) or
# set these in your shell or service definition. See docs/ENV_VARS.md.
NIGHTSCOUT_URL=https://your-nightscout.example.com
# A token with the "readable" role only. Never the API_SECRET.
NIGHTSCOUT_TOKEN=
LK_URGENT_LOW=55
LK_LOW=70
LK_HIGH=180
LK_URGENT_HIGH=250
LK_STALE_MINUTES=15
