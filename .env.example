# Example configuration for lightkeeper. Copy to .env (never committed) or
# set these in your shell or service definition. See docs/ENV_VARS.md.
NIGHTSCOUT_URL=https://your-nightscout.example.com
# A token with the "readable" role only. Never the API_SECRET.
NIGHTSCOUT_TOKEN=
LK_URGENT_LOW=55
LK_LOW=70
LK_HIGH=180
LK_URGENT_HIGH=250
LK_STALE_MINUTES=15
# Home Assistant over MQTT (optional, ADR-0010). Leave LK_MQTT_HOST empty to turn it off.
LK_MQTT_HOST=
LK_MQTT_PORT=8883
LK_MQTT_TLS=true
LK_MQTT_USERNAME=
LK_MQTT_PASSWORD=
LK_MQTT_DISCOVERY_PREFIX=homeassistant
LK_MQTT_NODE_ID=lightkeeper
